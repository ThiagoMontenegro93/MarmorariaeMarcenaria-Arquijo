# Copie para apps/api/.env (desenvolvimento local sem Docker)
NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://arquijo:DB_PASSWORD@localhost:5432/arquijo?schema=public"
JWT_SECRET=SECRET_KEY_AQUI
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000
WHATSAPP_PROVIDER=link
WHATSAPP_API_TOKEN=TOKEN_AQUI
WHATSAPP_PHONE_NUMBER_ID=
SEED_ADMIN_EMAIL=admin@arquijo.com.br
SEED_ADMIN_SENHA=

# Armazenamento de fotos (medições): local (disco/volume) ou s3 (próxima fase)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
