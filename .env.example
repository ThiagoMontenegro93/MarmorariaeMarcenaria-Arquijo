# ── Arquijo — variáveis do docker-compose ──
# Copie para .env e troque TODOS os placeholders antes de usar fora da sua máquina.

# Banco
POSTGRES_USER=arquijo
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=arquijo
DATABASE_URL=postgresql://arquijo:DB_PASSWORD@postgres:5432/arquijo?schema=public

# API
NODE_ENV=production
PORT=3001
# Gere com: openssl rand -base64 48   (mínimo 32 caracteres em produção)
JWT_SECRET=SECRET_KEY_AQUI
JWT_EXPIRES_IN=8h
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# WhatsApp: "link" (wa.me, Fase 1) ou "business_api" (Fase 2)
WHATSAPP_PROVIDER=link
WHATSAPP_API_TOKEN=TOKEN_AQUI
WHATSAPP_PHONE_NUMBER_ID=

# Google Maps (Fase 2 — mapa embarcado)
GOOGLE_MAPS_API_KEY=API_KEY_AQUI

# Seed do primeiro administrador
SEED_ADMIN_EMAIL=admin@arquijo.com.br
SEED_ADMIN_SENHA=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL_INTERNA=http://api:3001
